{
  "manifest_version": 3,
  "name": "Lentera Onko Vision Companion",
  "short_name": "Lentera Companion",
  "version": "1.0.0",
  "description": "Simpan edukasi, pertanyaan, dan catatan perjalanan kanker langsung dari browser Anda.",
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "action": {"default_popup":"src/popup/popup.html","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "background": {"service_worker":"assets/background.js","type":"module"},
  "options_page": "src/options/options.html",
  "permissions": ["storage","contextMenus","activeTab","scripting"],
  "host_permissions": [],
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'self'"}
}
